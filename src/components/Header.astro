---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove o slash inicial
---

<header class=" docked full-width top-0 sticky z-50 bg-surface-container-low/90 dark:bg-surface-container-low/90 border-b border-surface-container-highest backdrop-blur-md transition-all duration-300">
  <div class="flex justify-between items-center px-md py-sm max-w-container-max mx-auto w-full">
    <a class="flex items-center gap-base" href="/">
      <img alt="Raízes Logo" class="h-12 w-12 object-contain rounded-full" src="/Logo.jpeg"> 
      <span class="text-headline-md font-headline-md font-extrabold text-secondary dark:text-secondary-fixed hidden sm:block">Raízes</span>
    </a>
    
    <nav class="hidden md:flex gap-md items-center font-label-md text-label-md">
      <a class={`hover:text-primary transition-colors duration-200 ${currentPath === '' ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/">
        A Escola
      </a>
      <a class={`hover:text-primary transition-colors duration-200 ${currentPath === 'turmas' ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/Turmas">
        Turmas e Rotina
      </a>
    </nav>
    
    <div class="flex items-center gap-sm">
      <a href="/Contato" class="hidden md:flex bg-primary-container text-on-primary-container px-md py-sm rounded-full font-label-md text-label-md hover:-translate-y-1 hover:ambient-shadow-primary transition-all duration-300">
        Quero Matricular
      </a>
      <button class="md:hidden text-primary">
        <span class="material-symbols-outlined text-headline-lg">menu</span>
      </button>
    </div>
  </div>
</header>