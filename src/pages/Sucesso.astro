---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mensagem Recebida - Raízes Educação Infantil">
  <main class="grow flex flex-col items-center justify-center px-md min-h-[60vh] text-center gap-md">
    <span class="material-symbols-outlined text-primary" style="font-size: 5rem;">
      check_circle
    </span>
    
    <h1 class="text-headline-xl-mobile md:text-headline-xl font-headline-xl text-primary max-w-2xl">
      Obrigado! Recebemos sua mensagem
    </h1>

    <a href="/" class="mt-lg bg-primary-container text-on-primary-container py-md px-xl rounded-full font-label-md font-bold hover:brightness-95 transition-all">
      Voltar para a página inicial
    </a>
  </main>
</Layout>