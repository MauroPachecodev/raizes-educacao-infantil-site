---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contato - Raízes Educação Infantil">

  <main class="bg-surface-container-low font-sans relative overflow-hidden min-h-screen">
    <div class="absolute top--10% left--10% w-60% h-60% bg-primary-container/20 rounded-full blur-[120px] opacity-70 z-0 pointer-events-none"></div>
    <div class="absolute top--5% right--5% w-50% h-50% bg-secondary-container/20 rounded-full blur-[120px] opacity-60 z-0 pointer-events-none"></div>

    <div class="relative z-10">
      <section class="pt-24 pb-10 px-4 text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-extrabold text-on-surface mb-6 tracking-tight">
          Venha nos visitar
        </h1>
        <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed">
          Estamos de portas abertas para receber sua família. Preencha o formulário abaixo para agendarmos uma visita e conhecermos melhor as necessidades do seu pequeno.
        </p>
      </section>

      <section class="pb-24 px-4 max-w-4xl mx-auto">
        <div class="bg-surface-container-low/80 backdrop-blur-md p-8 md:p-12 rounded-3xl border border-outline-variant/30 shadow-sm">
          
          <form action="https://formsubmit.co/maurinpacheco@gmail.com" method="POST" class="space-y-6">
            
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_next" value="https://raizes-educacao-infantil-site.pages.dev/Contato">
            <input type="hidden" name="_template" value="table">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex flex-col gap-2">
                <label for="nome" class="text-sm font-semibold text-on-surface">Nome do Responsável</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/60">person</span>
                  <input 
                    type="text" 
                    id="nome" 
                    name="Nome do Responsável"
                    required
                    placeholder="Como podemos te chamar?" 
                    class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-outline-variant/50 bg-surface-container-high text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all placeholder:text-on-surface-variant/50" 
                  />
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-semibold text-on-surface">E-mail</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/60">mail</span>
                  <input 
                    type="email" 
                    id="email" 
                    name="Email"
                    required
                    placeholder="seu@email.com" 
                    class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-outline-variant/50 bg-surface-container-high text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all placeholder:text-on-surface-variant/50" 
                  />
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <label for="telefone" class="text-sm font-semibold text-on-surface">Telefone / WhatsApp</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/60">call</span>
                  <input 
                    type="tel" 
                    id="telefone" 
                    name="Telefone"
                    required
                    placeholder="(00) 00000-0000" 
                    class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-outline-variant/50 bg-surface-container-high text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all placeholder:text-on-surface-variant/50" 
                  />
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <label for="idade" class="text-sm font-semibold text-on-surface">Idade da Criança</label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/60">mood</span>
                  <select 
                    id="idade" 
                    name="Idade da Criança"
                    class="w-full pl-12 pr-10 py-3.5 rounded-xl border border-outline-variant/50 bg-surface-container-high focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all appearance-none text-on-surface-variant/80 invalid:text-on-surface-variant/50"
                    required
                  >
                    <option value="" disabled selected hidden>Selecione a idade</option>
                    <option value="2 a 3 anos" class="text-on-surface">2 a 3 anos</option>
                    <option value="4 a 5 anos" class="text-on-surface">4 a 5 anos</option>
                    <option value="5 a 6 anos" class="text-on-surface">5 a 6 anos</option>
                  </select>
                  <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-2 mt-6">
              <label for="mensagem" class="text-sm font-semibold text-on-surface">Mensagem (Opcional)</label>
              <textarea 
                id="mensagem" 
                name="Mensagem"
                rows="4" 
                placeholder="Conte-nos um pouco sobre o que você procura..." 
                class="w-full px-5 py-4 rounded-xl border border-outline-variant/50 bg-surface-container-high text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none placeholder:text-on-surface-variant/50"
              ></textarea>
            </div>

            <div class="flex justify-center pt-8">
              <button 
                type="submit" 
                class="bg-primary text-on-primary font-semibold py-3.5 px-8 rounded-full flex items-center gap-2 transition-all duration-300 shadow-sm hover:-translate-y-1 hover:ambient-shadow-primary cursor-pointer">
                Agendar Visita
                <span class="material-symbols-outlined text-xl">arrow_forward</span>
              </button>
            </div>
          </form>
          
        </div>

        <div class="text-center mt-12 text-on-surface-variant">
          Prefere ligar? <a href="tel:+550000000000" class="font-bold text-secondary hover:underline transition-all">Fale conosco agora</a>
        </div>
      </section>
    </div>
  </main>

</Layout>